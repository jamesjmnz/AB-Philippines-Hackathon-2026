{
  "name": "contradictions",
  "description": "True cross-person disagreements on floor, building or location, and hard negatives that look like conflicts but are not. Synthetic and fictional.",
  "scenarios": [
    {
      "id": "con-en-001",
      "split": "development",
      "language": "en",
      "tags": [
        "conflict"
      ],
      "statements": [
        {
          "id": "s1",
          "author": "reporter",
          "text": "I fell down a few steps in Building B and I'm sitting on the second floor landing. My ankle is sore. Please send someone to help me stand.",
          "confirms": {
            "floor": "second floor",
            "building": "Building B"
          }
        },
        {
          "id": "s2",
          "author": "responder_a",
          "text": "I am told the person is on the fourth floor, not the second."
        }
      ],
      "reference": {
        "extraction": [
          {
            "statementId": "s1",
            "fields": {
              "incidentType": {
                "status": "stated",
                "anyOf": [
                  "fell",
                  "fall"
                ]
              },
              "building": {
                "status": "stated",
                "anyOf": [
                  "B"
                ]
              },
              "floor": {
                "status": "stated",
                "anyOf": [
                  "2"
                ]
              },
              "locationText": {
                "status": "stated",
                "anyOf": [
                  "landing",
                  "steps"
                ]
              },
              "symptom": {
                "status": "stated",
                "anyOf": [
                  "ankle",
                  "sore"
                ]
              },
              "assistanceRequested": {
                "status": "stated",
                "anyOf": [
                  "stand"
                ]
              }
            }
          }
        ],
        "deltas": [
          {
            "statementId": "s2",
            "overall": "possible_contradiction",
            "fields": {
              "floor": "possible_contradiction"
            }
          }
        ],
        "conflicts": [
          {
            "field": "floor",
            "statementIds": [
              "s1",
              "s2"
            ]
          }
        ],
        "clarification": {
          "acceptable": [],
          "noneAcceptable": true
        },
        "forbidden": []
      },
      "notes": "The reporter confirmed the second floor; a responder later says the fourth. A confirmed human claim is not overwritten, and the disagreement is listed for a human."
    },
    {
      "id": "con-en-002",
      "split": "development",
      "language": "en",
      "tags": [
        "hard_negative"
      ],
      "statements": [
        {
          "id": "s1",
          "author": "reporter",
          "text": "Got my foot caught in a broken floor grate in the corridor by the labs, 2nd floor of the Science Hall. It's stuck and it aches."
        },
        {
          "id": "s2",
          "author": "responder_a",
          "text": "Second floor, Science Hall. I see them."
        },
        {
          "id": "s3",
          "author": "responder_b",
          "text": "I'm on the first floor, coming up to you."
        }
      ],
      "reference": {
        "extraction": [
          {
            "statementId": "s1",
            "fields": {
              "incidentType": {
                "status": "stated",
                "anyOf": [
                  "caught",
                  "stuck"
                ]
              },
              "building": {
                "status": "stated",
                "anyOf": [
                  "Science Hall"
                ]
              },
              "floor": {
                "status": "stated",
                "anyOf": [
                  "2"
                ]
              },
              "locationText": {
                "status": "stated",
                "anyOf": [
                  "corridor",
                  "lab",
                  "grate"
                ]
              },
              "symptom": {
                "status": "stated",
                "anyOf": [
                  "ache",
                  "foot"
                ]
              },
              "assistanceRequested": {
                "status": "unknown"
              }
            }
          }
        ],
        "deltas": [
          {
            "statementId": "s2",
            "overall": "confirmation",
            "fields": {
              "floor": "confirmation",
              "building": "confirmation"
            }
          },
          {
            "statementId": "s3",
            "overall": "no_meaningful_change",
            "fields": {}
          }
        ],
        "conflicts": [],
        "clarification": {
          "acceptable": [
            "assistanceRequested"
          ],
          "noneAcceptable": true
        },
        "forbidden": []
      },
      "notes": "\"2nd floor\" and \"Second floor\" are the same value. responder_b's first floor is their own position, so there is no conflict. \"Floor grate\" is not a floor."
    },
