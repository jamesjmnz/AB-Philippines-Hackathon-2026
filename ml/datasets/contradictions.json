        "deltas": [
          {
            "statementId": "s2",
            "overall": "no_meaningful_change",
            "fields": {}
          },
          {
            "statementId": "s3",
            "overall": "correction",
            "fields": {
              "floor": "correction"
            }
          }
        ],
        "conflicts": [],
        "clarification": {
          "acceptable": [],
          "noneAcceptable": true
        },
        "forbidden": []
      },
      "notes": "A question states no value, so mentioning the first floor in it is not a contradiction. The reporter then corrects their own floor, which is never a conflict."
