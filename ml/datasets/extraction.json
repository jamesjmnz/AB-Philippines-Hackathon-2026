    {
      "id": "ext-en-001",
      "split": "development",
      "language": "en",
      "tags": [
        "complete"
      ],
      "statements": [
        {
          "id": "s1",
          "author": "reporter",
          "text": "I slipped on the wet stairs in Building C, 3rd floor, near the east stairwell. My left wrist hurts and I can't move it much. Can someone help me get down to the lobby?"
        }
      ],
      "reference": {
        "extraction": [
          {
            "statementId": "s1",
            "fields": {
              "incidentType": {
                "status": "stated",
                "anyOf": [
                  "slip"
                ]
              },
              "building": {
                "status": "stated",
                "anyOf": [
                  "C"
                ]
              },
              "floor": {
                "status": "stated",
                "anyOf": [
                  "3"
                ]
              },
              "locationText": {
                "status": "stated",
                "anyOf": [
                  "stairwell",
                  "stairs"
                ]
              },
              "symptom": {
                "status": "stated",
                "anyOf": [
                  "wrist"
                ]
              },
              "assistanceRequested": {
                "status": "stated",
                "anyOf": [
                  "get down",
                  "lobby",
                  "help me down"
                ]
              }
            }
          }
        ],
        "deltas": [],
        "conflicts": [],
        "clarification": {
          "acceptable": [],
          "noneAcceptable": true
        },
        "forbidden": []
      },
      "notes": "Every field is stated outright. The lobby is where the person wants to go, not where they are, so it belongs only to the help requested."
    },
